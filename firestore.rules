rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isAdmin() {
      // Custom claim is the primary check; email fallback matches the app's
      // single-hardcoded-admin model used client-side (see src/lib/roleAuth.js)
      // since the claim-setting Cloud Function is not deployed for this project.
      return isAuthenticated() && (
        request.auth.token.role == "admin" ||
        request.auth.token.email.lower() == "sumitdivate3@gmail.com"
      );
    }

    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    // 1. Users collection
    match /users/{uid} {
      allow read: if isAuthenticated();
      allow write: if isOwner(uid) || isAdmin();
    }

    // 2. Events collection
    match /events/{eventId} {
      // Allow read for everyone (published events)
      allow read: if true;
      // Only the admin may create, edit or remove events
      allow create, update, delete: if isAdmin();

      // Sessions subcollection
      match /sessions/{sessionId} {
        allow read: if true;
        allow write: if isAdmin();
      }
    }

    // 3. Registrations collection
    // Document ID format: {uid}_{eventId}
    match /registrations/{registrationId} {
      // Read allowed for owner participant or admin
      allow read: if isAuthenticated() && (resource.data.uid == request.auth.uid || isAdmin());
      // Create allowed only for authenticated user registering for themselves
      allow create: if isAuthenticated() && request.resource.data.uid == request.auth.uid;
      // Registrations are immutable once created (no client update/delete path)
      allow update, delete: if false;
    }

    // 4. Attendance collection
    // Document ID format: {uid}_{eventId}
    match /attendance/{attendanceId} {
      // Read allowed for owner participant or admin
      allow read: if isAuthenticated() && (resource.data.uid == request.auth.uid || isAdmin());
      // Only the admin's authenticated client may record/override attendance
      allow create, update, delete: if isAdmin();
    }

    // 5. Feedback collection
    // Document ID format: {uid}_{eventId}
    match /feedback/{feedbackId} {
      allow read: if isAuthenticated() && (resource.data.uid == request.auth.uid || isAdmin());
      // Create allowed only if user is owner AND an attendance document exists for this user+event
      allow create: if isAuthenticated() 
        && request.resource.data.uid == request.auth.uid
        && exists(/databases/$(database)/documents/attendance/$(request.resource.data.uid + '_' + request.resource.data.eventId));
      allow update, delete: if isAdmin();
    }

  }
}
