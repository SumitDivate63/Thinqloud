rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isAdmin() {
      // Custom claim is the primary check; email fallback matches the app's
      // single-hardcoded-admin model used client-side (see src/lib/roleAuth.js)
      // since the claim-setting Cloud Function is not deployed for this project.
      return isAuthenticated() && (
        request.auth.token.role == "admin" ||
        request.auth.token.email.lower() == "sumitdivate3@gmail.com"
      );
    }

    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    // 1. Users collection
    match /users/{uid} {
      allow read: if isAuthenticated();
      allow write: if isOwner(uid) || isAdmin();
    }

    // 2. Events collection
    match /events/{eventId} {
      // Allow read for everyone (published events)
      allow read: if true;
      // Only the admin may create, edit or remove events
      allow create, update, delete: if isAdmin();

      // Sessions subcollection
      match /sessions/{sessionId} {
        allow read: if true;
        allow write: if isAdmin();
      }
    }

    // 3. Registrations collection
    // Document ID format: {uid}_{eventId}
    match /registrations/{registrationId} {
      // Read allowed for owner participant or admin. The app checks "does my
      // registration exist yet?" before creating one, so a not-yet-existing
      // doc must also be readable - resource.data errors out (and denies)
      // when resource is null, so !exists() must be checked first to
      // short-circuit before touching resource.data.
      allow read: if isAuthenticated() && (
        !exists(/databases/$(database)/documents/registrations/$(registrationId)) ||
        resource.data.uid == request.auth.uid ||
        isAdmin()
      );
      // Create allowed only for authenticated user registering for themselves
      allow create: if isAuthenticated() && request.resource.data.uid == request.auth.uid;
      // Registrations are immutable once created (no client update/delete path)
      allow update, delete: if false;
    }

    // 4. Attendance collection
    // Document ID format: {uid}_{eventId}
    match /attendance/{attendanceId} {
      // Same not-yet-existing-document reasoning as registrations above:
      // the admin scanner checks "already checked in?" before writing.
      allow read: if isAuthenticated() && (
        !exists(/databases/$(database)/documents/attendance/$(attendanceId)) ||
        resource.data.uid == request.auth.uid ||
        isAdmin()
      );
      // Only the admin's authenticated client may record attendance. Update
      // is intentionally denied (not just admin-gated): the app relies on a
      // second write to the same attendanceId being denied as its
      // "already checked in" signal, instead of reading the document first.
      allow create, delete: if isAdmin();
      allow update: if false;
    }

    // 5. Feedback collection
    // Document ID format: {uid}_{eventId}
    match /feedback/{feedbackId} {
      // Same not-yet-existing-document reasoning: the app checks "have I
      // already submitted feedback?" before creating.
      allow read: if isAuthenticated() && (
        !exists(/databases/$(database)/documents/feedback/$(feedbackId)) ||
        resource.data.uid == request.auth.uid ||
        isAdmin()
      );
      // Create allowed only if user is owner AND an attendance document exists for this user+event
      allow create: if isAuthenticated()
        && request.resource.data.uid == request.auth.uid
        && exists(/databases/$(database)/documents/attendance/$(request.resource.data.uid + '_' + request.resource.data.eventId));
      allow update, delete: if isAdmin();
    }

  }
}
